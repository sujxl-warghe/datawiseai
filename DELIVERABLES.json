  "mongodb_changes": {
    "collection": "fe_sessions",
    "schema_evolution": {
      "before": {
        "fields": [
          "file_id (string)",
          "current_path (string - BROKEN)",
          "original_path (string)",
          "steps (array)",
          "created_at (date)",
          "updated_at (date)"
        ],
        "problem": "current_path is temporary filesystem path that dies on restart"
      },
      "after": {
        "fields": [
          "file_id (string)",
          "csv_data (string - PRIMARY)",
          "json_data (array - BACKUP)",
          "columns (array)",
          "row_count (number)",
          "steps (array)",
          "created_at (date)",
          "updated_at (date)"
        ],
        "advantage": "csv_data persists forever in MongoDB"
      }
    },
    "indexes_recommended": [
      "file_id (unique)",
      "created_at (with TTL: 30 days)"
    ]
  },

